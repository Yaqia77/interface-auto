# Python
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境
.venv/
venv/

# 测试与报告产物（每次运行动态生成，不入库）
reports/
logs/
.pytest_cache/

# Jenkins/CI 工作区生成的 Allure 产物（固定目录名，不入库）
allure-results/
allure-report/

# 敏感凭证文件（本地填写真实账号密码，不入库；模板见 data/secret_vars_template.xlsx）
data/secret_vars.xlsx

# 测试场景运行时数据（用户创建的场景存储，不入库）
data/plans.json

# Webhook 通知配置（用户创建的推送规则，不入库）
data/webhooks.json

# 定时任务配置（用户创建的调度计划，不入库）
data/schedules.json

# Excel 打开时的临时文件
~$*

# 配置写回的备份/临时产物（平台保存环境配置时生成，不入库）
config/*.bak
config/*.tmp

# 本地私有文档（面试准备材料，不入库）
docs/

# IDE
.idea/
.vscode/

# 系统文件
.DS_Store
Thumbs.db
